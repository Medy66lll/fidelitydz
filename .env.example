# FidelityDZ - Variables d'Environnement (À configurer dans Vercel > Settings > Environment Variables)
# IMPORTANT : Ne commitez JAMAIS votre fichier .env ou .env.local sur GitHub !
# Aucun secret ne doit commencer par NEXT_PUBLIC_ !

NEXT_PUBLIC_PLATFORM_NAME=FidelityDZ
NEXT_PUBLIC_PLAN_PRICE_DZD=3900
NEXT_PUBLIC_APP_URL=https://fidelitydz.vercel.app

# Supabase (Clé publique ANON côté client, clé SERVICE_ROLE strictement côté serveur sur Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Authentification Propriétaire Super-Admin (/kazi-owner-dz) - Strictement côté serveur sur Vercel
ADMIN_PASSWORD=CHANGE_ME
OWNER_PIN=CHANGE_ME
SESSION_HMAC_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# Chargily Pay V2 - Clé secrète strictement côté serveur sur Vercel
NEXT_PUBLIC_CHARGILY_PUBLIC_KEY=CHANGE_ME
CHARGILY_SECRET_KEY=CHANGE_ME
